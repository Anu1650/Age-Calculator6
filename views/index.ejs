    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // DOM elements
            const nameInput = document.getElementById('name');
            const dayInput = document.getElementById('birth-day');
            const monthInput = document.getElementById('birth-month');
            const yearInput = document.getElementById('birth-year');
            const calculateBtn = document.getElementById('calculate-btn');
            const downloadBtn = document.getElementById('download-btn');
            const resultSection = document.getElementById('result-section');
            const calendarSection = document.getElementById('calendar-section');
            const personNameElement = document.getElementById('person-name');
            // Store birth date for download functionality
            let currentBirthDate = null;
            let currentToday = null;

            // Event listeners
            calculateBtn.addEventListener('click', calculateAgeHandler);
            downloadBtn.addEventListener('click', downloadResults);
            // Allow Enter key to trigger calculation
            [nameInput, dayInput, monthInput, yearInput].forEach(input => {
                input.addEventListener('keypress', function(e) {
                    if (e.key === 'Enter') {
                        calculateAgeHandler();
                    }
                });
            });

            function calculateAgeHandler() {
                // Get input values
                const name = nameInput.value.trim();
                const day = parseInt(dayInput.value);
                const month = parseInt(monthInput.value);
                const year = parseInt(yearInput.value);

                // Validate name
                if (!name) {
                    alert('Please enter your name');
                    return;
                }

                // Validate date
                if (isNaN(day) || isNaN(month) || isNaN(year) || month < 1 || month > 12) {
                    alert('Please enter a valid complete date');
                    return;
                }

                // Validate day based on month
                const daysInMonth = new Date(year, month, 0).getDate();
                if (day < 1 || day > daysInMonth) {
                    alert(`Please enter a valid day (1-${daysInMonth}) for the selected month`);
                    return;
                }

                // Create date objects
                const birthDate = new Date(year, month - 1, day);
                const today = new Date();

                // Store dates for download
                currentBirthDate = birthDate;
                currentToday = today;

                // Validate date
                if (birthDate > today) {
                    alert('Birth date cannot be in the future');
                    return;
                }

                // Display person's name
                personNameElement.textContent = name;

                // Calculate age
                calculateAge(birthDate, today);

                // Generate calendars
                generateCalendar(birthDate, 'birth-calendar', 'birthday');
                generateCalendar(today, 'current-calendar', 'today');

                // Show results
                resultSection.style.display = 'block';
                calendarSection.style.display = 'grid';
                downloadBtn.style.display = 'block';

                // Scroll to results
                setTimeout(() => {
                    resultSection.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }, 100);
            }

            function calculateAge(birthDate, currentDate) {
                let years = currentDate.getFullYear() - birthDate.getFullYear();
                let months = currentDate.getMonth() - birthDate.getMonth();
                let days = currentDate.getDate() - birthDate.getDate();

                // Adjust for negative months or days
                if (months < 0 || (months === 0 && days < 0)) {
                    years--;
                    months += 12;
                }

                if (days < 0) {
                    const lastMonth = new Date(currentDate.getFullYear(), currentDate.getMonth(), 0).getDate();
                    months--;
                    days += lastMonth;
                }

                // Calculate total time
                const timeDiff = currentDate - birthDate;
                const totalDays = Math.floor(timeDiff / (1000 * 60 * 60 * 24));
                const totalHours = Math.floor(timeDiff / (1000 * 60 * 60));
                const totalMinutes = Math.floor(timeDiff / (1000 * 60));
                const totalSeconds = Math.floor(timeDiff / 1000);
                const totalMilliseconds = timeDiff;
                const totalWeeks = Math.floor(totalDays / 7);
                const remainingDays = totalDays % 7;
                const totalMonths = years * 12 + months;

                // Format numbers with commas
                const formatNumber = num => num.toLocaleString();

                // Display results
                document.getElementById('age-result').textContent = `${years} years, ${months} months, ${days} days`;
                document.getElementById('years-result').textContent = formatNumber(years);
                document.getElementById('months-result').textContent = formatNumber(totalMonths);
                document.getElementById('weeks-result').textContent = formatNumber(totalWeeks);
                document.getElementById('remaining-days-result').textContent = remainingDays;
                document.getElementById('days-result').textContent = formatNumber(totalDays);
                document.getElementById('hours-result').textContent = formatNumber(totalHours);
                document.getElementById('minutes-result').textContent = formatNumber(totalMinutes);
                document.getElementById('seconds-result').textContent = formatNumber(totalSeconds);
                document.getElementById('milliseconds-result').textContent = formatNumber(totalMilliseconds);
            }

            function generateCalendar(date, elementId, highlightClass) {
                const year = date.getFullYear();
                const month = date.getMonth();
                const day = date.getDate();
                const monthNames = ["January", "February", "March", "April", "May", "June",
                                  "July", "August", "September", "October", "November", "December"];

                // Set calendar title
                document.getElementById(`${elementId}-title`).textContent =
                    `${monthNames[month]} ${year}`;

                // Get first day of month and total days
                const firstDay = new Date(year, month, 1).getDay();
                const daysInMonth = new Date(year, month + 1, 0).getDate();

                // Clear previous calendar
                const grid = document.getElementById(`${elementId}-grid`);
                grid.innerHTML = '';

                // Add day headers
                const dayNames = ['S', 'M', 'T', 'W', 'T', 'F', 'S'];
                dayNames.forEach(d => {
                    const dayElement = document.createElement('div');
                    dayElement.className = 'calendar-header';
                    dayElement.textContent = d;
                    grid.appendChild(dayElement);
                });

                // Add empty cells for days before the first day of month
                for (let i = 0; i < firstDay; i++) {
                    const emptyElement = document.createElement('div');
                    emptyElement.className = 'calendar-day empty';
                    grid.appendChild(emptyElement);
                }

                // Add days of month
                for (let i = 1; i <= daysInMonth; i++) {
                    const dayElement = document.createElement('div');
                    dayElement.className = 'calendar-day';
                    dayElement.textContent = i;

                    // Highlight current day or birthday
                    const today = new Date();
                    const isToday = i === today.getDate() && month === today.getMonth() && year === today.getFullYear() && highlightClass === 'today';
                    const isBirthday = i === day && highlightClass === 'birthday';

                    if (isToday) {
                        dayElement.classList.add('today');
                    }
                    if (isBirthday) {
                        dayElement.classList.add('birthday');
                    }

                    grid.appendChild(dayElement);
                }
            }

            function downloadResults() {
                const name = nameInput.value.trim();
                
                if (!currentBirthDate || !currentToday) {
                    alert('Please calculate your age first before downloading');
                    return;
                }

                // Generate fresh calendars for download
                const birthCalendarHTML = generateCalendarHTML(currentBirthDate, 'birthday');
                const currentCalendarHTML = generateCalendarHTML(currentToday, 'today');

                // Create a copy of the results HTML without the download button
                const tempDiv = document.createElement('div');
                tempDiv.innerHTML = document.getElementById('result-section').innerHTML;
                tempDiv.querySelector('#download-btn').remove();
                
                // Add website stamp
                const websiteStamp = document.createElement('div');
                websiteStamp.className = 'website-stamp';
                websiteStamp.innerHTML = '<p>Generated by <span class="logo">AgeCalculator.com</span> on ' + new Date().toLocaleDateString() + '</p>';
                tempDiv.appendChild(websiteStamp);

                const content = `
                    <!DOCTYPE html>
                    <html lang="en">
                    <head>
                        <meta charset="UTF-8">
                        <meta name="viewport" content="width=device-width, initial-scale=1.0">
                        <title>Age Calculation Results for ${name}</title>
                        <style>
                            ${document.querySelector('style').innerHTML}
                            #download-btn { display: none; }
                            .website-stamp {
                                text-align: center;
                                margin-top: 30px;
                                padding: 15px;
                                border-top: 2px solid #3498db;
                                color: #495057;
                                font-style: italic;
                            }
                            .website-stamp .logo {
                                font-weight: bold;
                                color: #3498db;
                                font-size: 1.2em;
                            }
                        </style>
                    </head>
                    <body>
                        <div class="header">
                            <h1>Age Calculation Results for ${name}</h1>
                            <p>Generated on ${new Date().toLocaleDateString()}</p>
                        </div>
                        <div class="calculator-container">
                            <div class="result-section" style="display:block;">${tempDiv.innerHTML}</div>
                            <div class="calendar-section" style="display:grid;">
                                <div class="calendar">
                                    <div class="calendar-title">${getMonthYearString(currentBirthDate)}</div>
                                    <div class="calendar-grid">${birthCalendarHTML}</div>
                                </div>
                                <div class="calendar">
                                    <div class="calendar-title">${getMonthYearString(currentToday)}</div>
                                    <div class="calendar-grid">${currentCalendarHTML}</div>
                                </div>
                            </div>
                        </div>
                    </body>
                    </html>
                `;

                const blob = new Blob([content], { type: 'text/html' });
                const a = document.createElement('a');
                a.href = URL.createObjectURL(blob);
                a.download = `age-calculation-results-${name.replace(/\s+/g, '-')}.html`;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
            }

            // Helper function to generate calendar HTML for download
            function generateCalendarHTML(date, highlightClass) {
                const year = date.getFullYear();
                const month = date.getMonth();
                const day = date.getDate();
                
                // Get first day of month and total days
                const firstDay = new Date(year, month, 1).getDay();
                const daysInMonth = new Date(year, month + 1, 0).getDate();

                let calendarHTML = '';
                
                // Add day headers
                const dayNames = ['S', 'M', 'T', 'W', 'T', 'F', 'S'];
                dayNames.forEach(d => {
                    calendarHTML += `<div class="calendar-header">${d}</div>`;
                });

                // Add empty cells for days before the first day of month
                for (let i = 0; i < firstDay; i++) {
                    calendarHTML += `<div class="calendar-day empty"></div>`;
                }

                // Add days of month
                for (let i = 1; i <= daysInMonth; i++) {
                    let dayClass = 'calendar-day';
                    
                    // Highlight current day or birthday
                    const today = new Date();
                    const isToday = i === today.getDate() && month === today.getMonth() && year === today.getFullYear() && highlightClass === 'today';
                    const isBirthday = i === day && highlightClass === 'birthday';

                    if (isToday) {
                        dayClass += ' today';
                    }
                    if (isBirthday) {
                        dayClass += ' birthday';
                    }

                    calendarHTML += `<div class="${dayClass}">${i}</div>`;
                }

                return calendarHTML;
            }

            // Helper function to get month and year string
            function getMonthYearString(date) {
                const monthNames = ["January", "February", "March", "April", "May", "June",
                                  "July", "August", "September", "October", "November", "December"];
                return `${monthNames[date.getMonth()]} ${date.getFullYear()}`;
            }
        });
    </script>
</body>
</html>