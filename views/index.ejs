        }

        .result-step {
            display: flex;
            margin-bottom: 15px;
            align-items: center;
            padding: 12px;
            border-radius: 6px;
            transition: background-color 0.2s;
        }

        .result-step:hover {
            background-color: rgba(52, 152, 219, 0.05);
        }

        .step-number {
            background-color: var(--primary-color);
            color: var(--white);
            width: 28px;
            height: 28px;
            border-radius: 50%;
