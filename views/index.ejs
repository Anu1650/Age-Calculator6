            align-items: center;
            justify-content: center;
            margin-right: 15px;
            font-size: 14px;
            flex-shrink: 0;
            font-weight: 600;
        }

        .step-text {
            flex-grow: 1;
            font-size: 16px;
        }

        .highlight {
            font-weight: 600;
            color: var(--highlight-color);
            margin-left: 5px;
        }

        .unit {
            color: var(--dark-gray);
            font-size: 0.9em;
            margin-left: 3px;
